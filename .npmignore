# Only package runtime artifacts should be published.

# Source and development folders
src/
docs/
examples/
tests/
scripts/
coverage/
.nyc_output/
.cache/
.opencode/

# Local configuration and tooling
.vscode/
.idea/
.github/
.npm/
.yarn/
.git/
.gitignore
.gitattributes
.editorconfig
.eslintrc*
.prettierrc*
nodemon.json
opencode.json

# Environment and temporary files
.env
.env.*
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db
*.swp
*.swo

# Project files not needed in the package
tsconfig.json
jest.config.js
bun.lock
package-lock.json
yarn.lock
pnpm-lock.yaml
data_uisi.xlsx
timetable-result.json
initial-solution.json
initial-state.json
unscheduled-classes.json

# Keep only package-level docs
*.md
!README.md
!CHANGELOG.md

# Keep the root license file published
!LICENSE
!LICENSE.md
