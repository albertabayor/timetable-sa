{
  "name": "timetable-sa",
  "version": "3.0.0",
  "description": "Generic, unopinionated Simulated Annealing library for constraint satisfaction problems. Solve timetabling, scheduling, resource allocation, and any optimization problem with custom constraints.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:verbose": "node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose",
    "prepublishOnly": "npm run clean && npm run build",
    "example:timetabling": "bun examples/timetabling/example-basic.ts",
    "example:timetabling:non-greedy": "bun examples/timetabling/example-non-greedy.ts",
    "build:binary": "bun scripts/build-binary.ts",
    "build:binary:all": "bun scripts/build-binary.ts --all",
    "build:binary:linux": "bun scripts/build-binary.ts --target=bun-linux-x64",
    "build:binary:macos": "bun scripts/build-binary.ts --target=bun-darwin-x64",
    "build:binary:macos-arm": "bun scripts/build-binary.ts --target=bun-darwin-arm64",
    "build:binary:windows": "bun scripts/build-binary.ts --target=bun-windows-x64"
  },
  "keywords": [
    "simulated-annealing",
    "optimization",
    "constraint-satisfaction",
    "csp",
    "scheduling",
    "timetabling",
    "generic",
    "unopinionated",
    "typescript",
    "resource-allocation",
    "optimization-algorithm",
    "metaheuristic"
  ],
  "author": "Benjamin Naphtali <benjamin.naphtali@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/albertabayor/timetable-sa.git"
  },
  "bugs": {
    "url": "https://github.com/albertabayor/timetable-sa/issues"
  },
  "homepage": "https://github.com/albertabayor/timetable-sa#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
